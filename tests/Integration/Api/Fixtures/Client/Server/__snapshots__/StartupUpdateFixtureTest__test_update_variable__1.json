{
    "object": "egg_variable",
    "attributes": {
        "name": "Server Jar",
        "description": "The jar file to run.",
        "env_variable": "SERVER_JARFILE",
        "default_value": "server.jar",
        "server_value": "frozen.jar",
        "is_editable": true,
        "rules": "required|string"
    },
    "meta": {
        "startup_command": "java -jar frozen.jar",
        "raw_startup_command": "java -jar {{SERVER_JARFILE}}"
    }
}
